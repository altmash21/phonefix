# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env on your production server.
# Run: php artisan key:generate
# Never commit your production .env with real credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME="Maurya Mobile"
APP_ENV=production
APP_LOCALE=en-GB
APP_INSTALLED=true
APP_KEY=base64:GENERATE_NEW_KEY_ON_PROD_SERVER=
APP_DEBUG=false
APP_SCHEDULE_TIME="09:00"
APP_URL=https://your-domain.com

# ── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Use a dedicated MySQL user (do NOT use root in production)
# Ensure MySQL port 3306 is bound to 127.0.0.1 and not exposed publicly
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobitrack_prod
DB_USERNAME=mobitrack_user
DB_PASSWORD="USE_A_STRONG_RANDOM_PASSWORD_HERE"
DB_PREFIX=9nj_

# ── CACHE & SESSIONS ────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── MAIL DISPATCH ───────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mauryamobile.com"
MAIL_FROM_NAME="Maurya Mobile ERP"

# ── OFFLINE SYNC API & RATE LIMITING ────────────────────────────────────────
API_PREFIX=api
API_STRICT=false
API_DEBUG=false
API_STANDARDS_TREE=vnd
API_SUBTYPE=mobitrack
API_VERSION=v3
API_MIDDLEWARE=api
